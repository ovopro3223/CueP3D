{
  "name": "@cuep3d/progressive-loader",
  "version": "0.1.0",
  "description": "Loads one glTF quality tier at a time (meshopt geometry + KTX2 textures) and warms it (shader compile + GPU upload + one off-screen render) before the viewer is allowed to show it.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:setup": "playwright install chromium"
  },
  "dependencies": {
    "@cuep3d/manifest": "workspace:*",
    "@cuep3d/stage": "workspace:*",
    "meshoptimizer": "^1.3.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
