{
  "name": "@understudy3d/viewer",
  "version": "0.1.0",
  "description": "The orchestrator: state machine, QualityPolicy, pointer-driven scrub, and the camera-synchronized cross-fade handoff from the proxy player to the progressively-streamed glTF.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:headed": "pnpm run build && playwright test -c e2e/playwright.config.ts --headed",
    "make-fixture": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "@understudy3d/manifest": "workspace:*",
    "@understudy3d/progressive-loader": "workspace:*",
    "@understudy3d/proxy-player": "workspace:*",
    "@understudy3d/stage": "workspace:*",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/three": "^0.186.0",
    "@understudy3d/build-encode": "workspace:*",
    "@understudy3d/build-proxy": "workspace:*",
    "esbuild": "^0.24.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
