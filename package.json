{
  "name": "understudy",
  "private": true,
  "version": "0.1.0",
  "description": "Instant AV1 orbit-video stand-in with seamless handoff to progressive glTF.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm run build && pnpm -r --if-present run typecheck",
    "test": "pnpm run build && pnpm -r --if-present run test",
    "understudy": "node packages/cli/dist/bin.js",
    "fetch-samples": "node scripts/fetch-samples.mjs",
    "demo:assets": "pnpm --filter @understudy3d/demo run build:assets",
    "make-fixtures": "node scripts/make-fixtures.mjs",
    "assert-free-codecs": "node scripts/assert-free-codecs.mjs",
    "bench": "pnpm --filter @understudy3d/bench run bench",
    "bench:gif": "pnpm --filter @understudy3d/bench run gif"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.20.0"
}
